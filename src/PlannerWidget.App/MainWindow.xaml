<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PlannerWidget.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PlannerWidget.App"
    xmlns:vm="using:PlannerWidget.App.ViewModels"
    Title="Planner Widget">

    <Grid x:Name="RootGrid" RowDefinitions="Auto,*">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnNewTaskAccelerator" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnSearchAccelerator" />
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
        </Grid.KeyboardAccelerators>

        <Grid.Resources>
            <!-- Feladatkártya -->
            <DataTemplate x:Key="TaskTemplate" x:DataType="vm:TaskItemViewModel">
                <Grid Margin="0,0,0,6"
                      CornerRadius="8"
                      BorderThickness="1"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      ColumnDefinitions="4,Auto,*,Auto"
                      RowDefinitions="Auto,Auto">

                    <!-- Ügynél az egész csempe halványan lilás -->
                    <Border Grid.RowSpan="2" Grid.ColumnSpan="4"
                            CornerRadius="7"
                            IsHitTestVisible="False"
                            Background="{x:Bind local:Ui.TicketCardTint(IsTicket), Mode=OneWay}" />

                    <Border Grid.RowSpan="2"
                            CornerRadius="7,0,0,7"
                            Background="{x:Bind local:Ui.Accent(DueState), Mode=OneWay}" />

                    <!-- A tooltip a keretén van: tiltott gomb (pl. ügy „Előbb kezdd el”) maga nem mutatna tooltipet. -->
                    <Grid Grid.Column="1"
                          Margin="4,6,0,0"
                          VerticalAlignment="Top"
                          Background="Transparent"
                          ToolTipService.ToolTip="{x:Bind CheckToolTip, Mode=OneWay}">
                        <Button Style="{StaticResource CheckButtonStyle}"
                                Command="{x:Bind ToggleCompleteCommand}"
                                Content="{x:Bind local:Ui.CheckGlyph(IsCompleted), Mode=OneWay}"
                                Foreground="{x:Bind local:Ui.CheckBrush(IsCompleted), Mode=OneWay}"
                                Visibility="{x:Bind ShowPlainCheck, Mode=OneWay}"
                                IsEnabled="{x:Bind CheckEnabled, Mode=OneWay}"
                                IsHitTestVisible="{x:Bind CheckEnabled, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind CheckToolTip, Mode=OneWay}" />
                        <!-- Nyitott ügy: a karika a továbblépés menüjét nyitja (visszalépés a „…” menüben) -->
                        <Button Style="{StaticResource CheckButtonStyle}"
                                Content="{x:Bind local:Ui.CheckGlyph(IsCompleted), Mode=OneWay}"
                                Foreground="{x:Bind local:Ui.TicketBrush}"
                                Visibility="{x:Bind ShowTicketCheck, Mode=OneWay}"
                                IsEnabled="{x:Bind TicketCheckEnabled, Mode=OneWay}"
                                IsHitTestVisible="{x:Bind TicketCheckEnabled, Mode=OneWay}"
                                AutomationProperties.Name="Következő lépés">
                            <Button.Flyout>
                                <MenuFlyout Placement="RightEdgeAlignedTop">
                                    <MenuFlyoutItem Text="{x:Bind TicketMenuHeader, Mode=OneWay}" IsEnabled="False" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Átvettem → Processed" Command="{x:Bind SetTicketStatusCommand}"
                                                    CommandParameter="Processed" Visibility="{x:Bind ShowTakeOver, Mode=OneWay}"
                                                    ToolTipService.ToolTip="A Beérkező ügyek listában néhány percen belül frissül.">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8FB;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Elkezdem → In progress" Command="{x:Bind SetTicketStatusCommand}"
                                                    CommandParameter="In progress" Visibility="{x:Bind ShowStart, Mode=OneWay}"
                                                    ToolTipService.ToolTip="A Beérkező ügyek listában néhány percen belül frissül.">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE768;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Folytatom → In progress" Command="{x:Bind SetTicketStatusCommand}"
                                                    CommandParameter="In progress" Visibility="{x:Bind ShowResume, Mode=OneWay}"
                                                    ToolTipService.ToolTip="A Beérkező ügyek listában néhány percen belül frissül.">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE768;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="{x:Bind FinishTicketText, Mode=OneWay}" Command="{x:Bind CompleteTicketCommand}"
                                                    IsEnabled="{x:Bind CanFinishTicket, Mode=OneWay}"
                                                    ToolTipService.ToolTip="Késznek jelölés – a ticket is lezárul. A Beérkező ügyek listában néhány percen belül frissül.">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE73E;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <!-- Cím és adatok: koppintásra kinyílnak a részletek -->
                    <StackPanel Grid.Column="2"
                                Padding="4,11,4,10"
                                Spacing="5"
                                Background="Transparent"
                                Tapped="{x:Bind OnTapped}">
                        <TextBlock Text="{x:Bind DisplayTitle, Mode=OneWay}"
                                   FontWeight="SemiBold"
                                   TextWrapping="WrapWholeWords"
                                   MaxLines="3"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{x:Bind local:Ui.Collapsed(IsTicket), Mode=OneWay}"
                                   Opacity="{x:Bind local:Ui.TitleOpacity(IsCompleted), Mode=OneWay}"
                                   TextDecorations="{x:Bind local:Ui.Strike(IsCompleted), Mode=OneWay}" />
                        <!-- Ügy: lilás cím, alatta kicsiben a ticket száma -->
                        <StackPanel Spacing="1" Visibility="{x:Bind IsTicket, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind TicketToolTip, Mode=OneWay}">
                            <TextBlock Text="{x:Bind DisplayTitle, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       TextWrapping="WrapWholeWords"
                                       MaxLines="3"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{x:Bind local:Ui.TicketBrush}"
                                       Opacity="{x:Bind local:Ui.TitleOpacity(IsCompleted), Mode=OneWay}"
                                       TextDecorations="{x:Bind local:Ui.Strike(IsCompleted), Mode=OneWay}" />
                            <TextBlock Text="{x:Bind TicketNumberText, Mode=OneWay}"
                                       FontSize="11"
                                       Foreground="{x:Bind local:Ui.TicketBrush}"
                                       Opacity="0.8"
                                       Visibility="{x:Bind HasTicketNumber, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Style="{StaticResource PillStyle}"
                                    Padding="6,1,7,2"
                                    Background="{x:Bind local:Ui.DueBackground(DueState), Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind DueToolTip, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE787;" FontSize="11"
                                              Foreground="{x:Bind local:Ui.DueForeground(DueState), Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind DueText, Mode=OneWay}" FontSize="12"
                                               Foreground="{x:Bind local:Ui.DueForeground(DueState), Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                        Visibility="{x:Bind local:Ui.PriorityVisibility(Priority, IsCompleted), Mode=OneWay}">
                                <FontIcon Glyph="&#xE7C1;" FontSize="11" Foreground="{x:Bind local:Ui.PriorityBrush(Priority), Mode=OneWay}" />
                                <TextBlock Text="{x:Bind PriorityText, Mode=OneWay}" FontSize="12"
                                           Foreground="{x:Bind local:Ui.PriorityBrush(Priority), Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                        Visibility="{x:Bind HasChecklist, Mode=OneWay}"
                                        ToolTipService.ToolTip="Ellenőrzőlista">
                                <FontIcon Glyph="&#xE9D5;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ChecklistText, Mode=OneWay}" Style="{StaticResource CaptionTextStyle}" />
                            </StackPanel>

                            <FontIcon Glyph="&#xE8A5;" FontSize="11" VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Visibility="{x:Bind HasDescription, Mode=OneWay}"
                                      ToolTipService.ToolTip="Van leírása" />
                        </StackPanel>

                        <!-- Ügy státusza (= Planner-gyűjtő = a Beérkező ügyek lista státusza); előre a karikával, vissza a „…”-val -->
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    Visibility="{x:Bind HasTicketStatus, Mode=OneWay}">
                            <Border Style="{StaticResource PillStyle}"
                                    Background="{x:Bind local:Ui.TicketStatusSoftBrush(TicketStatus), Mode=OneWay}"
                                    ToolTipService.ToolTip="Állapot (a Planner-gyűjtő; a Beérkező ügyek lista néhány perc késéssel követi)">
                                <TextBlock Text="{x:Bind TicketStatus, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{x:Bind local:Ui.TicketStatusBrush(TicketStatus), Mode=OneWay}" />
                            </Border>
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Width="28" Height="24" FontSize="12"
                                    Content="&#xE712;"
                                    Tapped="OnCardButtonTapped"
                                    Visibility="{x:Bind HasTicketMenu, Mode=OneWay}"
                                    IsEnabled="{x:Bind local:Ui.Not(IsBusy), Mode=OneWay}"
                                    ToolTipService.ToolTip="Vissza / más állapot. A Beérkező ügyek listában néhány percen belül frissül."
                                    AutomationProperties.Name="További állapotok">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuFlyoutItem Text="Sürgős (SOS)" Command="{x:Bind SetTicketStatusCommand}"
                                                        CommandParameter="SOS" IsEnabled="{x:Bind CanSetSos, Mode=OneWay}"
                                                        ToolTipService.ToolTip="A Beérkező ügyek listában néhány percen belül frissül." />
                                        <MenuFlyoutItem Text="Kérdéses (KÉRDÉSES)" Command="{x:Bind SetTicketStatusCommand}"
                                                        CommandParameter="KÉRDÉSES" IsEnabled="{x:Bind CanSetQuestionable, Mode=OneWay}"
                                                        ToolTipService.ToolTip="A Beérkező ügyek listában néhány percen belül frissül." />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Vissza New-ba" Command="{x:Bind SetTicketStatusCommand}"
                                                        CommandParameter="New" IsEnabled="{x:Bind CanSetNew, Mode=OneWay}"
                                                        ToolTipService.ToolTip="A Beérkező ügyek listában néhány percen belül frissül." />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <!-- Revisit: a rendszer újranyitotta, mert külsős válasz érkezett -->
                            <Border Style="{StaticResource PillStyle}"
                                    Background="{x:Bind local:Ui.TicketStatusSoftBrush('Revisit')}"
                                    Visibility="{x:Bind ShowNewReply, Mode=OneWay}"
                                    ToolTipService.ToolTip="A lezárt ügyre külsős válasz érkezett, ezért a rendszer újranyitotta (Revisit). Folytatás: a karikával.">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE8BD;" FontSize="11" Foreground="{x:Bind local:Ui.TicketStatusBrush('Revisit')}" />
                                    <TextBlock Text="Új válasz érkezett" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{x:Bind local:Ui.TicketStatusBrush('Revisit')}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{x:Bind PlanTitle, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{x:Bind ShowPlanTitle, Mode=OneWay}" />
                    </StackPanel>

                    <Grid Grid.Column="3" Margin="0,6,4,0" VerticalAlignment="Top">
                        <ProgressRing Width="16" Height="16" IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                      Visibility="{x:Bind IsBusy, Mode=OneWay}" />
                        <Button Style="{StaticResource IconButtonStyle}"
                                Content="&#xE712;"
                                Visibility="{x:Bind local:Ui.Collapsed(IsBusy), Mode=OneWay}"
                                ToolTipService.ToolTip="Műveletek"
                                AutomationProperties.Name="Műveletek">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem Text="Szerkesztés…" Command="{x:Bind EditCommand}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE70F;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Részletek" Command="{x:Bind ToggleDetailsCommand}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE946;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Megnyitás a Plannerben" Command="{x:Bind OpenCommand}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8A7;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Ticket megnyitása" Command="{x:Bind OpenTicketCommand}"
                                                    Visibility="{x:Bind HasTicketLink, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE715;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <!-- Ügynél nincs törlés: a felelőst a Beérkező ügyek listában kell módosítani. -->
                                    <MenuFlyoutItem Text="Felelős módosítása…" Command="{x:Bind ChangeAssigneeCommand}"
                                                    Visibility="{x:Bind IsTicket, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE77B;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Törlés" Command="{x:Bind DeleteCommand}" Foreground="{x:Bind local:Ui.RedBrush}"
                                                    Visibility="{x:Bind CanDelete, Mode=OneWay}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE74D;" Foreground="{x:Bind local:Ui.RedBrush}" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <!-- Részletek: leírás, ellenőrzőlista -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                Margin="12,0,12,12"
                                Spacing="6"
                                Visibility="{x:Bind IsExpanded, Mode=OneWay}">
                        <ProgressBar IsIndeterminate="True" Visibility="{x:Bind IsLoadingDetails, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind Description, Mode=OneWay}"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Visibility="{x:Bind HasDescriptionText, Mode=OneWay}" />
                        <ItemsRepeater ItemsSource="{x:Bind Checklist}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChecklistItemViewModel">
                                    <Grid>
                                        <Grid ColumnDefinitions="*,Auto"
                                              Visibility="{x:Bind local:Ui.Collapsed(IsEditing), Mode=OneWay}">
                                            <CheckBox Content="{x:Bind Title}"
                                                      MinHeight="28"
                                                      Padding="6,4,0,0"
                                                      IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                                      IsEnabled="{x:Bind local:Ui.Not(IsBusy), Mode=OneWay}" />
                                            <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                                                    Width="28" Height="28" FontSize="12" VerticalAlignment="Top"
                                                    Content="&#xE70F;"
                                                    Command="{x:Bind StartEditCommand}"
                                                    IsEnabled="{x:Bind local:Ui.Not(IsBusy), Mode=OneWay}"
                                                    ToolTipService.ToolTip="Szöveg szerkesztése"
                                                    AutomationProperties.Name="{x:Bind EditButtonName}" />
                                        </Grid>
                                        <StackPanel x:Name="ChecklistEditor" x:Load="{x:Bind IsEditing, Mode=OneWay}"
                                                    Spacing="4" Margin="0,2,0,4">
                                            <TextBox Text="{x:Bind EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     MaxLength="{x:Bind MaxLength}"
                                                     TextWrapping="Wrap"
                                                     FontSize="13"
                                                     IsEnabled="{x:Bind local:Ui.Not(IsBusy), Mode=OneWay}"
                                                     AutomationProperties.Name="Ellenőrzőlista-elem szövege"
                                                     Loaded="OnChecklistEditorLoaded"
                                                     PreviewKeyDown="OnChecklistEditorKeyDown" />
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                                <TextBlock VerticalAlignment="Center" FontSize="12"
                                                           Text="{x:Bind CounterText, Mode=OneWay}"
                                                           Foreground="{x:Bind local:Ui.CounterBrush(EditLength, MaxLength), Mode=OneWay}"
                                                           AutomationProperties.Name="{x:Bind CounterToolTip, Mode=OneWay}"
                                                           ToolTipService.ToolTip="{x:Bind CounterToolTip, Mode=OneWay}" />
                                                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                                                        Width="28" Height="28" FontSize="12"
                                                        Content="&#xE73E;"
                                                        Command="{x:Bind SaveEditCommand}"
                                                        ToolTipService.ToolTip="Mentés (Enter)"
                                                        AutomationProperties.Name="Szöveg mentése" />
                                                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}"
                                                        Width="28" Height="28" FontSize="12"
                                                        Content="&#xE711;"
                                                        Command="{x:Bind CancelEditCommand}"
                                                        ToolTipService.ToolTip="Mégse (Esc)"
                                                        AutomationProperties.Name="Szerkesztés megszakítása" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <TextBlock Text="Ennek a feladatnak nincs leírása vagy ellenőrzőlistája."
                                   Style="{StaticResource CaptionTextStyle}"
                                   Visibility="{x:Bind HasNoDetails, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <HyperlinkButton Padding="0" Command="{x:Bind OpenCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                                    <TextBlock Text="Megnyitás a Plannerben" FontSize="12" />
                                </StackPanel>
                            </HyperlinkButton>
                            <HyperlinkButton Padding="0" Command="{x:Bind OpenTicketCommand}"
                                             Visibility="{x:Bind HasTicketLink, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE715;" FontSize="12" />
                                    <TextBlock Text="Ticket megnyitása" FontSize="12" />
                                </StackPanel>
                            </HyperlinkButton>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <!-- ================= FEJLÉC ================= -->
        <Grid x:Name="HeaderGrid" Height="48" Padding="14,0,6,0" ColumnDefinitions="*,Auto">
            <Grid x:Name="DragRegion" Background="Transparent">
                <StackPanel x:Name="HeaderContent" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Image Source="ms-appx:///Assets/AppIcon.png" Width="18" Height="18" VerticalAlignment="Center" />

                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                               Foreground="{x:Bind local:Ui.StatusBrush(ViewModel.StatusKind), Mode=OneWay}"
                               FontWeight="SemiBold"
                               MaxWidth="196"
                               TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               VerticalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" Spacing="6"
                                Visibility="{x:Bind local:Ui.Collapsed(ViewModel.HasStatus), Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.HeaderTitle, Mode=OneWay}"
                                   FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        <Border Style="{StaticResource PillStyle}" Background="{x:Bind local:Ui.RedSoftBrush}"
                                Visibility="{x:Bind ViewModel.HasOverdue, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.OverdueText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{x:Bind local:Ui.RedBrush}" />
                        </Border>
                        <Border x:Name="TodayPill" Style="{StaticResource PillStyle}" Background="{x:Bind local:Ui.AmberSoftBrush}">
                            <TextBlock Text="{x:Bind ViewModel.DueTodayText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{x:Bind local:Ui.AmberBrush}" />
                        </Border>
                        <Border x:Name="TicketPill" Style="{StaticResource PillStyle}" Background="{x:Bind local:Ui.PurpleSoftBrush}"
                                Visibility="Collapsed"
                                ToolTipService.ToolTip="Nyitott beérkező ügyek">
                            <TextBlock Text="{x:Bind ViewModel.OpenTicketText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{x:Bind local:Ui.PurpleBrush}" />
                        </Border>
                    </StackPanel>

                    <Border x:Name="WorkPill" Style="{StaticResource PillStyle}" Background="{x:Bind local:Ui.BlueSoftBrush}"
                            Visibility="Collapsed"
                            ToolTipService.ToolTip="{x:Bind ViewModel.WorkToolTip, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE916;" FontSize="11" Foreground="{x:Bind local:Ui.BlueBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.WorkElapsedText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{x:Bind local:Ui.BlueBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="CompactButton"
                        Style="{StaticResource IconButtonStyle}"
                        Click="OnCompactClick"
                        ToolTipService.ToolTip="Összecsukás oldalra"
                        AutomationProperties.Name="Összecsukás oldalra" />
                <StackPanel x:Name="FullHeaderButtons" Orientation="Horizontal">
                    <!-- Szinkronhibák (To Do „Szinkronhibák” lista): csak ha van hiba vagy leállt az életjel -->
                    <Button x:Name="SyncButton"
                            Style="{StaticResource IconButtonStyle}"
                            Width="Auto" MinWidth="32" Padding="6,0"
                            Visibility="{x:Bind ViewModel.HasSyncIssues, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.SyncToolTip, Mode=OneWay}"
                            AutomationProperties.Name="Szinkronhibák">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{x:Bind local:Ui.SyncBrush(ViewModel.SyncIsError), Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.SyncBadgeText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                       FontFamily="{ThemeResource ContentControlThemeFontFamily}" VerticalAlignment="Center"
                                       Foreground="{x:Bind local:Ui.SyncBrush(ViewModel.SyncIsError), Mode=OneWay}" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="316" Spacing="8">
                                    <TextBlock Text="Szinkronhibák" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind ViewModel.HeartbeatWarning, Mode=OneWay}" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{x:Bind local:Ui.SyncWarningBrush}"
                                               Visibility="{x:Bind ViewModel.HasHeartbeatWarning, Mode=OneWay}" />
                                    <TextBlock Text="Nincs megoldatlan hiba." Style="{StaticResource CaptionTextStyle}"
                                               Visibility="{x:Bind ViewModel.HasNoSyncErrors, Mode=OneWay}" />
                                    <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
                                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.SyncErrorGroups}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Spacing="6" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SyncErrorGroupViewModel">
                                                    <Border Padding="10,8" CornerRadius="6" BorderThickness="1"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind ProcessName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                <TextBlock Text="{x:Bind DetailText}" Style="{StaticResource CaptionTextStyle}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <Button Content="Megnyitás" Padding="8,3" FontSize="12"
                                                                        Command="{x:Bind OpenCommand}" IsEnabled="{x:Bind HasLink}"
                                                                        ToolTipService.ToolTip="A hibás futás megnyitása a Power Automate-ben" />
                                                                <Button Content="Megoldva" Padding="8,3" FontSize="12"
                                                                        Command="{x:Bind ResolveCommand}"
                                                                        IsEnabled="{x:Bind local:Ui.Not(IsBusy), Mode=OneWay}"
                                                                        ToolTipService.ToolTip="{x:Bind ResolveToolTip}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </ScrollViewer>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Grid Width="32" Height="32">
                        <Button Style="{StaticResource IconButtonStyle}"
                                Content="&#xE72C;"
                                Command="{x:Bind ViewModel.RefreshCommand}"
                                Visibility="{x:Bind local:Ui.Collapsed(ViewModel.IsBusy), Mode=OneWay}"
                                ToolTipService.ToolTip="Frissítés"
                                KeyboardAcceleratorPlacementMode="Hidden"
                                AutomationProperties.Name="Frissítés" />
                        <ProgressRing Width="16" Height="16"
                                      IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    </Grid>
                    <Button x:Name="ExpandButton"
                            Style="{StaticResource IconButtonStyle}"
                            Click="OnExpandClick"
                            ToolTipService.ToolTip="Kinyitás / becsukás"
                            AutomationProperties.Name="Kinyitás vagy becsukás" />
                    <Button Style="{StaticResource CloseButtonStyle}"
                            Content="&#xE8BB;"
                            Click="OnCloseClick"
                            ToolTipService.ToolTip="Bezárás"
                            AutomationProperties.Name="Bezárás" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ================= TARTALOM ================= -->
        <Grid x:Name="ContentRoot"
              Grid.Row="1"
              RowDefinitions="Auto,*"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0">

            <InfoBar Margin="12,10,12,0"
                     IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}"
                     Title="{x:Bind ViewModel.ErrorTitle, Mode=OneWay}"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     Severity="{x:Bind local:Ui.Severity(ViewModel.ErrorSeverity), Mode=OneWay}" />

            <!-- Kijelentkezett állapot -->
            <StackPanel Grid.Row="1"
                        Visibility="{x:Bind ViewModel.IsSignedOut, Mode=OneWay}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        MaxWidth="300"
                        Padding="24"
                        Spacing="14">
                <Image Source="ms-appx:///Assets/AppIcon.png" Width="72" Height="72" />
                <TextBlock Text="Planner Widget" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="Jelentkezz be a munkahelyi Microsoft 365-fiókoddal, és a Planner-feladataid itt jelennek meg."
                           TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        MinWidth="170"
                        AutomationProperties.Name="{x:Bind ViewModel.SignInButtonText, Mode=OneWay}"
                        Command="{x:Bind ViewModel.SignInCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing Width="14" Height="14"
                                      IsActive="{x:Bind ViewModel.IsSigningIn, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.IsSigningIn, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.SignInButtonText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{x:Bind ViewModel.HotkeyHint, Mode=OneWay}"
                           Style="{StaticResource CaptionTextStyle}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Bejelentkezett állapot -->
            <Grid Grid.Row="1"
                  Visibility="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}"
                  RowDefinitions="Auto,Auto,Auto,*">

                <!-- Eszköztár -->
                <Grid Padding="12,10,8,8" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
                    <Button x:Name="WrappedButton" Padding="0" Background="Transparent" BorderThickness="0"
                            Width="36" Height="36" CornerRadius="18"
                            Click="OnWrappedClick"
                            ToolTipService.ToolTip="Havi összegzés"
                            AutomationProperties.Name="Havi összegzés">
                        <Grid Width="32" Height="32">
                            <PersonPicture Width="32" Height="32"
                                           Initials="{x:Bind ViewModel.ProfileInitials, Mode=OneWay}"
                                           DisplayName="{x:Bind ViewModel.UserDisplayName, Mode=OneWay}" />
                            <Ellipse Width="11" Height="11" Fill="#E5383B" Stroke="{ThemeResource LayerFillColorDefaultBrush}"
                                     StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Visibility="{x:Bind ViewModel.WrappedHasUnseen, Mode=OneWay}" />
                        </Grid>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <StackPanel Width="300" Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                        <Button Style="{StaticResource IconButtonStyle}" Content="&#xE76B;"
                                                Command="{x:Bind ViewModel.WrappedPrevCommand}"
                                                IsEnabled="{x:Bind ViewModel.WrappedCanPrev, Mode=OneWay}"
                                                AutomationProperties.Name="Előző hónap" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.WrappedTitle, Mode=OneWay}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Content="&#xE76C;"
                                                Command="{x:Bind ViewModel.WrappedNextCommand}"
                                                IsEnabled="{x:Bind ViewModel.WrappedCanNext, Mode=OneWay}"
                                                AutomationProperties.Name="Következő hónap" />
                                    </Grid>
                                    <TextBlock Text="{x:Bind ViewModel.WrappedEmptyText, Mode=OneWay}" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{x:Bind local:Ui.Collapsed(ViewModel.WrappedHasReport), Mode=OneWay}" />
                                    <ScrollViewer MaxHeight="360"><ItemsRepeater ItemsSource="{x:Bind ViewModel.WrappedLines}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="6" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:WrappedLine">
                                                <Border CornerRadius="8" Padding="12,8"
                                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                    <StackPanel>
                                                        <TextBlock Text="{x:Bind Value}" FontSize="22" FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                        <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextStyle}"
                                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2"
                                                                   Visibility="{x:Bind HasDetail}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater></ScrollViewer>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" HorizontalAlignment="Left">
                            <TextBlock Text="{x:Bind ViewModel.UserDisplayName, Mode=OneWay}"
                                       FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                            <Border Grid.Column="1" Style="{StaticResource PillStyle}" Padding="5,0,5,1"
                                    Background="{x:Bind local:Ui.BlueSoftBrush}"
                                    Visibility="{x:Bind ViewModel.IsDemo}"
                                    ToolTipService.ToolTip="Bemutató mód: kitalált adatok, semmi nem kerül a Plannerbe.">
                                <TextBlock Text="BEMUTATÓ" FontSize="10" FontWeight="SemiBold" Foreground="{x:Bind local:Ui.BlueBrush}" />
                            </Border>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.LastRefreshText, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextStyle}" FontSize="11" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Command="{x:Bind ViewModel.ToggleWorkCommand}"
                            IsEnabled="{x:Bind local:Ui.Not(ViewModel.IsWorkBusy), Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind ViewModel.WorkButtonText, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.WorkToolTip, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="{x:Bind ViewModel.WorkButtonGlyph, Mode=OneWay}" FontSize="12" />
                            <TextBlock Text="{x:Bind ViewModel.WorkButtonLabel, Mode=OneWay}" FontSize="12" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3"
                            Style="{StaticResource IconButtonStyle}"
                            Content="&#xE710;"
                            Command="{x:Bind ViewModel.ToggleAddPanelCommand}"
                            ToolTipService.ToolTip="Új feladat (Ctrl+N)"
                            AutomationProperties.Name="Új feladat" />

                    <Button Grid.Column="4"
                            Style="{StaticResource IconButtonStyle}"
                            Content="&#xE712;"
                            ToolTipService.ToolTip="Továbbiak"
                            AutomationProperties.Name="Továbbiak">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem Text="Megnyitás a Plannerben" Command="{x:Bind ViewModel.OpenPlannerCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8A7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Sorrend visszaállítása (határidő szerint)"
                                                Command="{x:Bind ViewModel.ResetOrderCommand}"
                                                IsEnabled="{x:Bind ViewModel.HasManualOrder, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8CB;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Beállítások…" Click="OnSettingsClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE713;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Kijelentkezés" Command="{x:Bind ViewModel.SignOutCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xF3B1;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Kilépés" Click="OnQuitClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7E8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <!-- Új feladat -->
                <Border Grid.Row="1"
                        Margin="12,0,12,10"
                        Padding="12"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Visibility="{x:Bind ViewModel.IsAddPanelOpen, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBox x:Name="NewTaskTitleBox"
                                 PlaceholderText="Új feladat címe…"
                                 Text="{x:Bind ViewModel.NewTaskTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnNewTaskTitleKeyDown" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <ComboBox HorizontalAlignment="Stretch"
                                      PlaceholderText="Terv"
                                      ItemsSource="{x:Bind ViewModel.AddPlans}"
                                      SelectedItem="{x:Bind ViewModel.NewTaskPlan, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Terv"
                                      AutomationProperties.Name="Terv" />
                            <ComboBox Grid.Column="1"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="Oszlop"
                                      ItemsSource="{x:Bind ViewModel.AddBuckets}"
                                      SelectedItem="{x:Bind ViewModel.NewTaskBucket, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Oszlop (bucket) – az utoljára választottat megjegyzi"
                                      AutomationProperties.Name="Oszlop" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                            <CalendarDatePicker HorizontalAlignment="Stretch"
                                                PlaceholderText="Nincs határidő"
                                                AutomationProperties.Name="Határidő"
                                                FirstDayOfWeek="Monday"
                                                Date="{x:Bind ViewModel.NewTaskDue, Mode=TwoWay}" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource IconButtonStyle}"
                                    Content="&#xE711;"
                                    FontSize="11"
                                    Command="{x:Bind ViewModel.ClearNewTaskDueCommand}"
                                    ToolTipService.ToolTip="Határidő törlése"
                                    AutomationProperties.Name="Határidő törlése" />
                            <ComboBox Grid.Column="2"
                                      Margin="4,0,0,0"
                                      Width="108"
                                      ItemsSource="{x:Bind vm:MainViewModel.PriorityOptions}"
                                      SelectedIndex="{x:Bind ViewModel.NewTaskPriorityIndex, Mode=TwoWay}"
                                      ToolTipService.ToolTip="Prioritás"
                                      AutomationProperties.Name="Prioritás" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <ProgressRing Width="16" Height="16"
                                          IsActive="{x:Bind ViewModel.IsLoadingBuckets, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.IsLoadingBuckets, Mode=OneWay}" />
                            <Button Content="Mégse" Command="{x:Bind ViewModel.ToggleAddPanelCommand}" />
                            <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.AddTaskCommand}"
                                    AutomationProperties.Name="Hozzáadás">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ProgressRing Width="14" Height="14"
                                                  IsActive="{x:Bind ViewModel.IsAdding, Mode=OneWay}"
                                                  Visibility="{x:Bind ViewModel.IsAdding, Mode=OneWay}" />
                                    <TextBlock Text="Hozzáadás" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Keresés és szűrés -->
                <Grid Grid.Row="2" Margin="12,0,12,8" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="SearchBox"
                             PlaceholderText="Keresés… (Ctrl+F)"
                             Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Grid.Column="1"
                              MaxWidth="150"
                              ItemsSource="{x:Bind ViewModel.PlanFilterOptions}"
                              SelectedItem="{x:Bind ViewModel.SelectedPlanFilter, Mode=TwoWay}"
                              ToolTipService.ToolTip="Szűrés tervre"
                              AutomationProperties.Name="Szűrés tervre" />
                </Grid>

                <!-- Feladatlista -->
                <!-- Aktív feladatok: húzással átrendezhetők (a sorrendet a nézetmodell ellenőrzi és menti).
                     A ListView a görgető is, így húzáskor a lista szélénél magától görget. -->
                <!-- VerticalAlignment=Top: rövid listánál csak a tartalomnyi magasság, így a lábléc közvetlenül
                     a feladatok alatt marad (különben a lista kitöltené a sort, és a lábléc az aljára kerülne). -->
                <ListView x:Name="ActiveList" Grid.Row="3" Padding="12,0,12,12" VerticalAlignment="Top"
                          ItemsSource="{x:Bind ViewModel.ActiveTasks}"
                          ItemTemplate="{StaticResource TaskTemplate}"
                          ItemContainerStyle="{StaticResource TaskItemContainerStyle}"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          CanDragItems="True"
                          CanReorderItems="True"
                          AllowDrop="True"
                          DragItemsStarting="OnActiveDragStarting"
                          DragItemsCompleted="OnActiveDragCompleted"
                          AutomationProperties.Name="Aktív feladatok (húzással átrendezhetők)">
                    <ListView.Resources>
                        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                    </ListView.Resources>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Frissítéskor a lista teteje maradjon a helyén (alapból a látható elemekhez igazodna,
                                 és az elejére beszúrt feladatok kicsúsznának felül). -->
                            <ItemsStackPanel ItemsUpdatingScrollMode="KeepScrollOffset" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.Footer>
                        <StackPanel>
                            <TextBlock Margin="12,24"
                                       Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind ViewModel.HasNoActiveTasks, Mode=OneWay}" />

                            <Expander Margin="0,6,0,0"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch"
                                      Header="{x:Bind ViewModel.CompletedHeader, Mode=OneWay}"
                                      AutomationProperties.Name="{x:Bind ViewModel.CompletedHeader, Mode=OneWay}"
                                      IsExpanded="{x:Bind ViewModel.IsCompletedExpanded, Mode=TwoWay}"
                                      Visibility="{x:Bind ViewModel.HasCompleted, Mode=OneWay}">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10"
                                                Visibility="{x:Bind ViewModel.HasMultiplePages, Mode=OneWay}">
                                        <Button Style="{StaticResource IconButtonStyle}" Content="&#xE76B;"
                                                Command="{x:Bind ViewModel.PreviousPageCommand}"
                                                IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}"
                                                AutomationProperties.Name="Előző oldal" />
                                        <TextBlock Text="{x:Bind ViewModel.PageText, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <Button Style="{StaticResource IconButtonStyle}" Content="&#xE76C;"
                                                Command="{x:Bind ViewModel.NextPageCommand}"
                                                IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"
                                                AutomationProperties.Name="Következő oldal" />
                                    </StackPanel>
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.CompletedPageTasks}" ItemTemplate="{StaticResource TaskTemplate}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ListView.Footer>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Window>
